<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="35dp"
            android:foreground="@color/transparent"
            app:cardCornerRadius="16dp"
            android:paddingHorizontal="20dp"
            app:cardBackgroundColor="@color/app_color2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/white"
            app:strokeWidth="3dp">




            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/contrainRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:foreground="@color/transparent"
                android:paddingHorizontal="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="40dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imvAvtRate"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="28dp"
                    android:src="@drawable/ic_rate_rero"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/roboto_medium"
                    android:freezesText="true"
                    android:gravity="center"

                    android:text="@string/zero_star_title"
                    android:textColor="@color/app_color"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imvAvtRate"
                    app:outerStrokeColor="@color/app_color"
                    app:outerStrokeWidth="1dp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:freezesText="true"
                    android:gravity="center"
                    android:text="@string/zero_star"
                    android:textColor="#99242424"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv1" />

                <com.willy.ratingbar.ScaleRatingBar
                    android:id="@+id/ll1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv2"
                    app:srb_clearRatingEnabled="false"
                    app:srb_clickable="true"
                    app:srb_drawableEmpty="@drawable/ic_rate_not"
                    app:srb_drawableFilled="@drawable/ic_rate"
                    app:srb_isIndicator="false"
                    app:srb_minimumStars="0"
                    app:srb_numStars="0"
                    app:srb_rating="0"
                    app:srb_scrollable="true"
                    app:srb_starHeight="30dp"
                    app:srb_starPadding="4dp"
                    app:srb_starWidth="30dp"
                    app:srb_stepSize="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ll1">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="@color/app_color3"
                        app:cardCornerRadius="100dp"
                        app:cardElevation="0dp"
                        android:layout_gravity="center"
                        app:strokeColor="@color/white"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/btnVote"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/roboto_medium"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:text="@string/rate"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="16sp" />
                    </com.google.android.material.card.MaterialCardView>
                    <!--                <androidx.appcompat.widget.AppCompatButton-->
                    <!--                    android:id="@+id/btnVote"-->
                    <!--                    android:layout_width="match_parent"-->
                    <!--                    android:layout_height="40dp"-->
                    <!--                    android:layout_marginTop="20dp"-->
                    <!--                    android:background="@drawable/frame_bg_rate"-->
                    <!--                    android:fontFamily="@font/roboto_medium"-->
                    <!--                    android:gravity="center"-->
                    <!--                    android:text="@string/rate"-->
                    <!--                    android:textAllCaps="false"-->
                    <!--                    android:textColor="@color/white"-->
                    <!--                    android:textSize="14sp" />-->

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btnExit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:paddingHorizontal="30dp"
                        android:paddingVertical="10dp"
                        android:text="@string/exit"
                        android:textAllCaps="false"
                        android:textColor="@color/app_color"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
