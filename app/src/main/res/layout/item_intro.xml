<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:clipToOutline="false"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imvImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_intro1"
        app:layout_constraintBottom_toTopOf="@+id/tvContent"
        android:layout_marginBottom="17dp"
        app:layout_constraintTop_toTopOf="parent" />

    <com.oc.catemoji.catoc.core.extention.OuterStrokeTextView
        android:id="@+id/tvContent"
        style="@style/single_marquee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:gravity="center"
        android:fontFamily="@font/kavoon_regular"
        android:textColor="@color/white"
        app:outerStrokeWidth="1.5dp"
        android:includeFontPadding="true"
        app:outerStrokeColor="@color/app_color"
        android:textSize="16sp"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>