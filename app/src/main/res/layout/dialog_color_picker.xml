<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginHorizontal="20dp"
            android:paddingVertical="16dp"
            app:cardCornerRadius="20dp"
            app:strokeWidth="3dp"
            app:strokeColor="@color/white"
            app:cardBackgroundColor="@color/app_color2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">




            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/contrainColor"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                >



                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitle"
                    style="@style/single_marquee"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:fontFamily="@font/kavoon_regular"
                    android:gravity="center"
                    android:textColor="@color/app_color"
                    android:paddingHorizontal="5dp"
                    android:paddingTop="12dp"
                    android:text="@string/choose_color"
                    android:textSize="24sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"

                    />

                <ir.kotlin.kavehcolorpicker.KavehColorPicker
                    android:id="@+id/colorPickerView"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginHorizontal="11dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="11dp"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/colorPickerView">

                    <ir.kotlin.kavehcolorpicker.KavehHueSlider
                        android:id="@+id/hueSlider"
                        android:layout_marginHorizontal="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="24dp" />

                    <!--                btnDone-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/bg"
                        android:layout_marginTop="16dp"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/txtContent">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnCancle"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginHorizontal="5dp"
                            app:layout_constraintDimensionRatio="1.48:0.44"
                            app:layout_constraintEnd_toStartOf="@+id/btnSave"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeColor="@color/app_color2"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/imgCancleFor"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:src="@drawable/bg_frame_successfalse" />

                            <TextView
                                android:id="@+id/txtCancle"
                                style="@style/single_marquee"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="@+id/imgCancleFor"
                                app:layout_constraintTop_toTopOf="@+id/imgCancleFor"
                                app:layout_constraintBottom_toBottomOf="@+id/imgCancleFor"
                                android:fontFamily="@font/kavoon_regular"
                                android:gravity="center"
                                android:text="@string/cancel"
                                android:textColor="@color/app_color"

                                android:textSize="16sp" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnSave"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginHorizontal="5dp"
                            app:layout_constraintDimensionRatio="1.48:0.44"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/btnCancle"
                            app:layout_constraintTop_toTopOf="@+id/btnCancle"
                            app:strokeColor="@color/app_color2"
                            app:strokeWidth="1dp">


                            <ImageView
                                android:id="@+id/imgSaveFor"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:src="@drawable/bg_frame_successtrue" />

                            <TextView
                                android:id="@+id/txtSave"
                                style="@style/single_marquee"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="@+id/imgSaveFor"
                                app:layout_constraintTop_toTopOf="@+id/imgSaveFor"
                                app:layout_constraintBottom_toBottomOf="@+id/imgSaveFor"
                                android:fontFamily="@font/kavoon_regular"
                                android:gravity="center"
                                android:text="@string/done"
                                android:textColor="@color/white"
                                android:textSize="16sp"  />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>