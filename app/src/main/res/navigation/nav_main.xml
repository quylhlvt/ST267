<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.oc.catemoji.catoc.ui.main.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_createPony"
            app:destination="@id/createPony"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/homeFragment" />
        <action
            android:id="@+id/action_home_to_frame_design"
            app:destination="@id/frameDesignFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/homeFragment" />

        <action
            android:id="@+id/action_home_to_myPony"
            app:destination="@id/myPony"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"
            />


        <action
            android:id="@+id/action_home_to_setting"
            app:destination="@id/nav_setting"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>
    <fragment
        android:id="@+id/successFragment"
        android:name="com.oc.catemoji.catoc.ui.main.success.SuccessFragment"
        android:label="fragment_success"
        tools:layout="@layout/fragment_success">

        <argument
            android:name="imagePath"
            android:defaultValue=""
            app:argType="string" />

        <action
            android:id="@+id/action_success_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_success_to_myPony"
            app:destination="@id/myPony"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/createPony"
        android:name="com.oc.catemoji.catoc.ui.main.createPony.ChooseAvatarFragment"
        android:label="Create Pony"
        tools:layout="@layout/fragment_choose_avatar">
        <action
            android:id="@+id/action_createPony_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_createPony_to_custom"
            app:destination="@id/custom"
            app:popUpTo="@id/createPony"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/myPony"
        android:name="com.oc.catemoji.catoc.ui.main.myPony.MyPonyFragment"
        android:label="My Pony"
        tools:layout="@layout/fragment_my_pony">
        <action
            android:id="@+id/action_mypony_to_custom"
            app:destination="@id/custom"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/myPony"
            app:popUpToInclusive="false" />

        <action
            android:id="@+id/action_mypony_to_view"
            app:destination="@id/viewFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/myPony"
            app:popUpToInclusive="false" />

        <action
            android:id="@+id/action_my_pony_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/custom"
        android:name="com.oc.catemoji.catoc.ui.main.customize.CustomizeFragment"
        android:label="Custom"
        tools:layout="@layout/fragment_customize">

        <action
            android:id="@+id/action_customizeFragment_to_addFragment"
            app:destination="@id/addCharacterFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_custom_to_myPony"
            app:destination="@id/myPony"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            app:popUpTo="@id/myPony"
            app:popUpToInclusive="false" />
    </fragment>
    <fragment
        android:id="@+id/addCharacterFragment"
        android:name="com.oc.catemoji.catoc.ui.main.add_character.AddCharacterFragment"
        android:label="fragment_add_character"
        tools:layout="@layout/fragment_add_character">

        <argument
            android:name="imagePath"
            android:defaultValue=""
            app:argType="string" />
        <action
            android:id="@+id/action_addCharacterFragment_tosuccessFragment"
            app:destination="@id/successFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            />
    </fragment>
    <fragment
        android:id="@+id/viewFragment"
        android:name="com.oc.catemoji.catoc.ui.main.view.ViewFragment"
        android:label="fragment_view"
        tools:layout="@layout/fragment_view">

        <argument
            android:name="imagePath"
            app:argType="string" />
        <argument
            android:name="imageType"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="idEdit"
            app:argType="string" />

        <action
            android:id="@+id/action_view_to_myPony"
            app:destination="@id/myPony"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            />

        <!-- ✅ Thêm action này -->
        <action
            android:id="@+id/action_view_to_customize"
            app:destination="@id/custom"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/viewFragment"
            />

    </fragment>
    <fragment
        android:id="@+id/frameDesignFragment"
        android:name="com.oc.catemoji.catoc.ui.main.frameDesign.addFrame.FrameDesignFragment"
        android:label="FrameDesignFragment" >
        <action
            android:id="@+id/action_frameDesignFragment_toaddOneFrameFragment"
            app:destination="@id/addOneFrameFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            />
    </fragment>
    <fragment
        android:id="@+id/addOneFrameFragment"
        android:name="com.oc.catemoji.catoc.ui.main.frameDesign.addOneFrame.AddOneFrameFragment"
        android:label="fragment_add_one_frame"
        tools:layout="@layout/fragment_add_one_frame" >
        <argument
            android:name="imagePathFrame"
            android:defaultValue=""
            app:argType="string" />
        <action
            android:id="@+id/action_addOneFrameFragment_tosuccessfulFrameFragment"
            app:destination="@id/successfulFrameFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            />
    </fragment>
    <fragment
        android:id="@+id/successfulFrameFragment"
        android:name="com.oc.catemoji.catoc.ui.main.frameDesign.successful.SuccessfulFrameFragment"
        android:label="fragment_successful_frame"
        tools:layout="@layout/fragment_successful_frame" >
        <argument
            android:name="imagePathFrame"
            android:defaultValue=""
            app:argType="string" />

        <action
            android:id="@+id/action_successfulFrameFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_successfulFrameFragment_to_myPony"
            app:destination="@id/myPony"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>


</navigation>
